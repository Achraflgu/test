# Optimized Dockerfile for Railway (Alpine-based, memory-efficient)
FROM node:18-alpine

# Install essential packages and Python tools (split for better caching)
RUN apk add --no-cache \
    python3 \
    py3-pip \
    python3-dev \
    gcc \
    g++ \
    make \
    ffmpeg \
    curl \
    wget

# Set working directory
WORKDIR /app

# Copy package files from server directory
COPY server/package*.json ./

# Install Node.js dependencies (production only, reduces size)
RUN npm ci --only=production --no-audit --no-fund

# Copy requirements.txt first (for better Docker layer caching)
COPY server/requirements.txt ./

# Install Python dependencies in virtual environment (memory-efficient)
# Use --no-cache-dir and split pip install to reduce memory usage
RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel && \
    /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

# Copy application code from server directory (last, for better caching)
COPY server/ .

# Set PATH to include virtual environment
ENV PATH="/opt/venv/bin:$PATH"

# Expose port
EXPOSE 3001

# Start the server
CMD ["node", "index.js"]
