# Simplified Dockerfile for Railway
FROM node:18-alpine

# Install only essential packages
RUN apk add --no-cache \
    python3 \
    py3-pip \
    ffmpeg

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install Node.js dependencies
RUN npm install --production

# Copy application code
COPY . .

# Expose port
EXPOSE 3001

# Start the server
CMD ["node", "index.js"]
