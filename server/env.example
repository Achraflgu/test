# Backend Environment Variables
# Copy this file to .env and update the values

# Server Port
PORT=3001

# Node environment (production/development)
NODE_ENV=development

# Frontend URL (for CORS)
# For local development:
FRONTEND_URL=http://localhost:8080

# For production (Vercel), add your Vercel URL:
# FRONTEND_URL=https://your-app.vercel.app

# ========== DATABASE (MongoDB) ==========
# MongoDB connection string for persistent storage (cookies, proxies, metadata)
# Get free tier from: https://mongodb.com/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/trackminer?retryWrites=true&w=majority

# Download folder path (optional - defaults to ~/Downloads)
# DOWNLOAD_FOLDER=/tmp/downloads

# Auto-update dependencies (optional - defaults to true)
# Set to 'false' to disable automatic daily updates of yt-dlp, spotdl, youtube-dl-exec, youtubei.js
# AUTO_UPDATE=false

# ========== RESOURCE MANAGEMENT (Railway Stability) ==========
# Configure resource limits to prevent Railway crashes and auto-restarts
# Railway free tier: 512MB RAM, 0.5 vCPU

# Maximum memory limit in MB (default: 512)
# Railway will restart if memory exceeds this limit
# MAX_MEMORY_MB=512

# Maximum concurrent child processes (default: 5)
# Limits spawned yt-dlp, spotdl processes to prevent resource exhaustion
# MAX_PROCESSES=5

# Maximum concurrent downloads (default: 3)
# Limits simultaneous download operations to prevent overload
# MAX_DOWNLOADS=3

# CPU usage threshold percentage (default: 80)
# Monitoring threshold - warnings logged when CPU exceeds this
# CPU_THRESHOLD=80

# ========== YOUTUBE BLOCKING SOLUTIONS ==========

# ⭐ RECOMMENDED: YouTube Cookies (FREE, 98% success rate) - MOST RELIABLE ⭐
# This is the ONLY method that consistently bypasses YouTube's bot detection
# Export from browser and paste the content as environment variable
# See: server/cookies-setup.md for detailed instructions
# YOUTUBE_COOKIES=cookie_content_here

# ⚠️ WARNING: All proxy solutions below have LOW success rates (20-40%)
# YouTube detects automated behavior regardless of IP address
# Use these ONLY if you cannot use cookies

# Option 2: Oxylabs Proxy (PAID $100+/month, 85-99% success rate) ⭐ BEST PROXY
# Professional residential/datacenter proxies - HIGHLY EFFECTIVE for YouTube
# Get credentials from: https://oxylabs.io/
# Format: Separate username and password
OXYLABS_USERNAME=your_username
OXYLABS_PASSWORD=your_password
# Note: The system will automatically use residential proxies (pr.oxylabs.io:7777)
# This provides the best success rate for YouTube downloads

# Option 3: ScraperAPI (PAID $29+/month, 20-30% success rate)
# Get your API key from: https://www.scraperapi.com/
# Free tier: 5,000 requests/month - LIMITED SUCCESS
# SCRAPERAPI_KEY=your_api_key_here

# Option 4: Free Rotating Proxies (FREE, 10-20% success rate)
# Uses public proxy lists - VERY UNRELIABLE
# Set to 'true' to enable
# USE_FREE_PROXIES=true

# 💡 BOTTOM LINE: Use cookies. All other methods are unreliable.

