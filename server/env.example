# Backend Environment Variables
# Copy this file to .env and update the values

# Server Port
PORT=3001

# Frontend URL (for CORS)
# For local development:
FRONTEND_URL=http://localhost:8080

# For production (Netlify), add your Netlify URL:
# FRONTEND_URL=https://your-app-name.netlify.app

# Download folder path (optional - defaults to ~/Downloads)
# DOWNLOAD_FOLDER=/tmp/downloads

# ========== YOUTUBE BLOCKING SOLUTIONS (Pick ONE) ==========

# Option 1: YouTube Cookies (FREE, 98% success rate) - RECOMMENDED
# Export from browser and paste the content as environment variable
# YOUTUBE_COOKIES=cookie_content_here

# Option 2: Oxylabs Proxy (PAID, 95% success rate, BEST) - PREMIUM
# Professional proxy service with rotating residential IPs
# Format: http://username:password@proxy-host:port
# OXYLABS_PROXY=http://user-username-country-US:password@dc.oxylabs.io:8000

# Option 3: ScraperAPI (PAID, 90% success rate, Good)
# Get your free API key from: https://www.scraperapi.com/
# Free tier: 5,000 requests/month
# SCRAPERAPI_KEY=your_api_key_here

# Option 4: Free Rotating Proxies (FREE, 50-70% success rate)
# Uses public proxy lists - completely free but less reliable
# Set to 'true' to enable
# USE_FREE_PROXIES=true

