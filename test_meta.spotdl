        "lyrics": "\u0644\u0627\u0632\u0645\u0646\u064a \u0644\u064a\u0644\u0629 \u0643\u064a\u0645\u0627 \u0627\u0644\u0644\u064a\u0644\u0629 \u0623\u0630\u064a\u0627\n\u0642\u0670\u0645\u0631\u0629 \u0623\u0642\u0631\u0628 \u0645\u0644\u064a \u062d\u0633\u0628\u062a\u0648\u0627 \u0639\u0632\u064a\u0632 \u0639\u0644\u064a\u0627\n\u0642\u0670\u0644\u0628\u064a \u0623\u0628\u0631\u062f \u0645\u0646\u0648 \u0637\u0642\u0633 \u0627\u0644\u0644\u064a\u0644\u0629 \u0623\u0630\u064a\u0627\n\u0639\u0645\u0631\u064a\u2005\u0643\u0644\u0648\u2005\u064a\u0648\u0644\u064a \u0643\u064a\u0645\u0627 \u0627\u0644\u0644\u064a\u0644\u0629\u2005\u0623\u0630\u064a\u0627  yeah\n\u0644\u0627\u0632\u0645\u0646\u064a \u0644\u064a\u0644\u0629 \u0643\u064a\u0645\u0627 \u0627\u0644\u0644\u064a\u0644\u0629\u2005\u0623\u0630\u064a\u0627\n\u0642\u0652\u0645\u0631\u0629 \u0623\u0642\u0631\u0628 \u0645\u0644\u064a \u062d\u0633\u0628\u062a\u0648\u0627 \u0639\u0632\u064a\u0632 \u0639\u0644\u064a\u0627\n\u0642\u0652\u0644\u0628\u064a \u0623\u0628\u0631\u062f \u0645\u0646\u0648 \u0637\u0642\u0633 \u0627\u0644\u0644\u064a\u0644\u0629 \u0623\u0630\u064a\u0627\n\u0639\u0645\u0631\u064a \u0643\u0644\u0648 \u064a\u0648\u0644\u064a \u0643\u064a\u0645\u0627 \u0627\u0644\u0644\u064a\u0644\u0629 \u0647\u0630\u064a\u0627 yeah eyy\n\n\u0641\u064a \u0638\u0647\u0631\u064a \u062a\u062a\u0634\u0627\u0645\u0648 \u062a\u0636\u062d\u0643\u0648\u0627 \u0642\u062f\u0627\u0645\u064a\n\u0646\u0641\u0633 \u0627\u0644\u0625\u0628\u062a\u0633\u0627\u0645\u0629 \u0623\u0645\u0627 \u062a\u062a\u0628\u062f\u0644 \u0627\u0644\u0623\u0633\u0627\u0645\u064a\n\u0627\u0644\u0623\u0635\u062d\u0627\u0628 \u0625\u0644\u064a \u0643\u0627\u0646\u0648\u0627 \u0644\u0627 \u0645\u0627\u0639\u0627\u062f\u0634 \u0643\u064a\u0645\u0627 \u0643\u0627\u0646\u0648\u0627\n\u0628\u062f\u0651\u0644 \u0627\u0644\u0627\u0628\u062a\u0633\u0627\u0645\u0629 \u0631\u063a\u0645 \u0627\u0644\u064a \u0646\u0641\u0633 \u0627\u0644\u0623\u0633\u0627\u0645\u064a\n\u0645\u0633\u062a\u062d\u064a\u0644 \u062a\u062e\u0631\u062c \u0645\u0646\u0647\u0627 \u0643\u064a\u0645\u0627 \u062c\u064a\u062a yeah yeah !\n\u062a\u0631\u0628\u062d \u0648 \u062a\u062e\u0633\u0631 \u062a\u0646\u0642\u0635 \u0648 \u062a\u0632\u064a\u062f yeah yeah !\n\u0645\u0646\u062d\u0643\u064a\u0634 \u0645\u0646\u0633\u0645\u0639\u0634 \u0645\u0627 \u0645\u0644\u0651\u064a\u062a yeah yeah !\n\u0639\u0627\u0648\u062f \u0641\u064a \u0627\u0644\u062d\u062f\u064a\u062b \u0644\u0627 \u0645\u0627 \u064a\u0641\u064a\u062f yeah yeah yeah yeah\n\u0642\u0670\u0639\u062f\u0648\u0644\u064a \u0643\u0627\u0646 \u0630\u0643\u0631\u064a\u0627\u062a \u0623\u0633\u0627\u0645\u064a\n\u062d\u062a\u0649 \u062a\u0641\u0643\u0631 \u0641\u064a\u0651\u0627 \u0641\u0643\u0651\u0631 \u0631\u0648\u062d\u0643 \u0628\u0634 \u062a\u0646\u0633\u0627\u0646\u064a\n\u0633\u0643\u0631\u0627\u0646 \u0648 \u0645\u062a\u0643\u064a\u0651\u0641 \u0648 \u0642\u0670\u0627\u0639\u062f \u0628\u062d\u0630\u0627 \u0634\u064a\u0637\u0627\u0646\u064a \u0646\u0627 \u062a\u0627\u0639\u0628 \u062e\u0627\u0637\u0631\u0646\u064a \u0646\u062d\u0628\u0651\u0643 \u0623\u0645\u0627 \u0646\u0638\u0647\u0631\u0644\u0643 \u0623\u0646\u0627\u0646\u064a yeah\nI just want some love yeah yeah\n\u0645\u0646 \u062a\u0648\u0642\u0651\u0639\u0627\u062a\u064a \u0631\u0643\u0628\u0646\u064a \u0627\u0644\u062e\u0648\u0641 yeah yeah !\n\u062a\u0642\u0639\u062f \u0643\u064a\u0645\u0627 \u0623\u0646\u062a\u064a \u0632\u0639\u0645\u0627 \u0646\u0642\u0639\u062f \u0643\u064a\u0645\u0627 \u0646\u0627\n\u0645\u062a\u0648\u0639\u062f\u0646\u064a\u0634 \u0648 \u0645\u0648\u0634 \u0644\u0627\u0632\u0645 \u062a\u062d\u0644\u0641 \u0625\u0645\u0627\u0646\u0627\u062a\n\n\u0643\u064a\u0645\u0627 \u0627\u0644\u0644\u064a\u0644\u0629 \u0647\u0630\u064a\u0627 \u0642\u0645\u0631\u0629 \u0623\u0642\u0631\u0628 \u0645\u0644\u064a \u062d\u0633\u0628\u062a\u0648\u0627 \u0639\u0632\u064a\u0632 \u0639\u0644\u064a\u0651\u0627\n\u0642\u0670\u0644\u0628